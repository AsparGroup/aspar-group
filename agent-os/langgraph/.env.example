# Never commit real secrets.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local orchestration
LANGGRAPH_URL=http://127.0.0.1:2024
LANGSMITH_API_KEY=
ODOO_URL=http://127.0.0.1:8069

# Optional persistent LangGraph checkpoint store
# Example only: postgresql://user:password@localhost:5432/aspar?sslmode=disable
LANGGRAPH_POSTGRES_URI=

# Worker identity — credential must be provisioned outside Git
ASPAR_WORKER_ID=
ASPAR_WORKER_TOKEN=

# Second LangGraph-orchestrated agent (deepseek_worker.py) — DeepSeek via
# NVIDIA Build's free, OpenAI-compatible tier (build.nvidia.com). Generate
# your own key there; never reuse a key that has been pasted into a chat.
NVIDIA_API_KEY=
