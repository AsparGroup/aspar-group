COMPOSE_PROJECT_NAME=notoria

# Postgres
POSTGRES_DB=notoria
POSTGRES_USER=notoria
POSTGRES_PASSWORD=notoria
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_BUCKET=notoria

# Services
ORCHESTRATOR_PORT=8000
WORKER_TTS_PORT=8101
WORKER_VIDEO_PORT=8102
WORKER_LIPSYNC_PORT=8103
WORKER_ENHANCE_PORT=8104
WORKER_QA_PORT=8105

# Worker TTS
USE_FAKE_TTS=true
USE_FAKE_VIDEO=true
CUDA_VISIBLE_DEVICES=0
USE_FAKE_LIPSYNC=true
USE_FAKE_ENHANCE=true
USE_FAKE_QA=true
ORCHESTRATOR_MAX_RETRIES=2
WORKER_TIMEOUT_SECONDS=15
